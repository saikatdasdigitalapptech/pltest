{
  "name": "digital-aptech-ai-commerce-playwright",
  "version": "1.0.0",
  "description": "Playwright TypeScript quality framework for Digital Aptech AI Commerce",
  "scripts": {
    "test": "node scripts/run-suite.mjs smoke",
    "test:smoke": "node scripts/run-suite.mjs smoke",
    "test:regression": "node scripts/run-suite.mjs regression",
    "test:cross-browser": "node scripts/run-suite.mjs cross-browser",
    "test:mobile": "node scripts/run-suite.mjs mobile",
    "test:api": "node scripts/run-suite.mjs api",
    "test:a11y": "node scripts/run-suite.mjs a11y",
    "test:audit": "node scripts/run-suite.mjs audit",
    "test:framework": "node scripts/run-suite.mjs framework",
    "test:all": "node scripts/run-suite.mjs all",
    "test:visual": "node scripts/run-suite.mjs visual",
    "test:visual:update": "node scripts/run-suite.mjs visual --update-snapshots",
    "test:scheduler": "node scripts/run-suite.mjs scheduler",
    "test:allure": "node scripts/run-suite.mjs regression --allure",
    "test:ui": "playwright test --project=chromium --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "browsers:install": "playwright install chromium firefox webkit",
    "report": "playwright show-report reports/html --port 9323",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report --port 9324",
    "report:merge": "playwright merge-reports --config=playwright.merge.config.ts ./all-blob-reports",
    "clean": "node scripts/clean.mjs"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "allure-commandline": "2.46.1",
    "allure-playwright": "3.13.0",
    "dotenv": "18.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-playwright": "2.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "zod": "4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25"
  },
  "packageManager": "npm@11.9.0"
}
