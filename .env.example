# Environment variables supplied by CI take precedence over .env files.
TEST_ENV=production
BASE_URL=https://digitalaptech.com
AI_COMMERCE_PATH=/services/ai-commerce/
WORKERS=2
RETRIES=0
HEADLESS=true
# Optional proxy for a corporate network; never commit proxy credentials.
# TEST_PROXY_SERVER=http://proxy.example:8080
# TEST_PROXY_USERNAME=
# TEST_PROXY_PASSWORD=
ENABLE_ALLURE=false
ENABLE_VISUAL=false
ENABLE_SCHEDULER=false
# Set only in a controlled environment with an agreed performance budget.
ENFORCE_PERFORMANCE=false
MAX_DOM_CONTENT_LOADED_MS=10000
MAX_TTFB_MS=3000
